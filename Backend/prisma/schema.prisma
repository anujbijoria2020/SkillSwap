generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  bio       String?
  avatarUrl String?
  location  String?
  availability String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillsOffered   SkillOffered[]
  skillsWanted    SkillWanted[]
initiatedSwaps Swap[] @relation("Initiator")
receivedSwaps  Swap[] @relation("Receiver")
  sessions        Session[]
  messagesSent    Message[]      @relation("Sender")
  messagesReceived Message[] @relation("Receiver")
  reviewsGiven    Review[]       @relation("Reviewer")
  reviewsReceived Review[]       @relation("Reviewee")
  refreshTokens RefreshToken[]
  notifications Notification[]
  notificationsTriggered Notification[] @relation("NotificationActor")
  settings UserSettings?
}

model SkillOffered {
  id     String @id @default(uuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillWanted {
  id     String @id @default(uuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Swap {
  id           String     @id @default(uuid())
  initiatorId  String
  receiverId   String
  skillOffered String
  skillWanted  String
  status       SwapStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  initiator User      @relation("Initiator", fields: [initiatorId], references: [id])
  receiver  User      @relation("Receiver", fields: [receiverId], references: [id])
  sessions  Session[]
  messages  Message[]
}

model Session {
  id          String        @id @default(uuid())
  swapId      String
  userId      String
  scheduledAt DateTime
  meetLink    String?
  status      SessionStatus @default(SCHEDULED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  swap Swap @relation(fields: [swapId], references: [id])
  user User @relation(fields: [userId], references: [id])
  review Review?
}

model Message {
  id         String   @id @default(uuid())
  swapId     String
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  swap     Swap @relation(fields: [swapId], references: [id])
  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  reviewerId String
  revieweeId String
  sessionId  String   @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  reviewer User    @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee User    @relation("Reviewee", fields: [revieweeId], references: [id])
  session  Session @relation(fields: [sessionId], references: [id])
}
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}

// Notification model:
// - id, userId, type, message, link, read, actorId, createdAt
// - relation to User (userId)
// - relation to User (actorId) — who triggered it

// UserSettings model:
// - id, userId (unique)
// - discovery, dmsFromAnyone, showPoints (boolean defaults true)
// - notifSwaps, notifMessages, notifReviews (boolean defaults true)
// - relation to User

// Add relations on User model:
// - notifications Notification[]
// - notificationsTriggered Notification[] @relation("NotificationActor")
// - settings UserSettings?


model Notification{
  id String @id @default(uuid())
  userId String
  type String
  message String
  link String?
  read Boolean @default(false)
  actorId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model UserSettings{
  id String @id @default(uuid())
  userId String @unique
  discovery Boolean @default(true)
  dmsFromAnyone Boolean @default(true)
  showPoints Boolean @default(true)
  notifSwaps Boolean @default(true)
  notifMessages Boolean @default(true)
  notifReviews Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}